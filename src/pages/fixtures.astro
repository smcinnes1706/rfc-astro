---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import FixtureList from '../components/FixtureList.astro';
import ResultList from '../components/ResultList.astro';

const all = await getCollection('fixtures');
const today = new Date();
const todayStr = today.toISOString().slice(0, 10);

// Sort all entries by date descending
all.sort((a, b) => b.data.date.localeCompare(a.data.date));

// Upcoming: no result, date >= today (ascending order for display)
const fixtures = all
  .filter(f => !f.data.result && f.data.date >= todayStr)
  .reverse();

// Results: has a result field, most recent first
const results = all.filter(f => !!f.data.result);

function formatDate(dateStr: string) {
  const d = new Date(dateStr);
  const day = String(d.getDate()).padStart(2, '0');
  const month = String(d.getMonth() + 1).padStart(2, '0');
  const year = d.getFullYear();
  return `${day}/${month}/${year}`;
}
---
<Layout title="Fixtures & Results" description="Upcoming fixtures and recent results for Rotherfield FC.">
  <div class="page-hero">
    <div class="container">
      <h1>Fixtures &amp; Results</h1>
      <p>Upcoming fixtures and recent results for all RFC teams.</p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <!-- Tab UI (JS progressively enhances) -->
      <div class="tab-bar" role="tablist">
        <button class="tab-btn active" role="tab" aria-selected="true" data-tab="fixtures">Upcoming Fixtures</button>
        <button class="tab-btn" role="tab" aria-selected="false" data-tab="results">Recent Results</button>
      </div>

      <div id="tab-fixtures" class="tab-panel active">
        <FixtureList fixtures={fixtures} formatDate={formatDate} />
      </div>

      <div id="tab-results" class="tab-panel">
        <ResultList results={results} formatDate={formatDate} />
      </div>
    </div>
  </section>
</Layout>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.tab-btn');

  function activateTab(tabKey: string) {
    tabs.forEach(t => {
      const isActive = t.dataset.tab === tabKey;
      t.classList.toggle('active', isActive);
      t.setAttribute('aria-selected', String(isActive));
    });

    document.querySelectorAll('.tab-panel').forEach(panel => {
      const isActive = panel.id === `tab-${tabKey}`;
      panel.classList.toggle('active', isActive);
    });
  }

  tabs.forEach(btn => {
    btn.addEventListener('click', () => {
      const tabKey = btn.dataset.tab;
      if (!tabKey) return;
      history.pushState(null, '', `#${tabKey}`);
      activateTab(tabKey);
    });
  });

  const initialTab = window.location.hash.replace('#', '') || 'fixtures';
  if (tabs.length) {
    activateTab(initialTab);
  }
</script>
