---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { fixtureTeamMetaByKey } from '../data/teams';

const all = await getCollection('fixtures');
const today = new Date();
const todayStr = today.toISOString().slice(0, 10);

// Sort all entries by date descending
all.sort((a, b) => b.data.date.localeCompare(a.data.date));

// Upcoming: no result, date >= today (ascending order for display)
const fixtures = all
  .filter(f => !f.data.result && f.data.date >= todayStr)
  .reverse();

// Results: has a result field, most recent first
const results = all.filter(f => !!f.data.result);

function formatDate(dateStr: string) {
  const d = new Date(dateStr);
  const day = String(d.getDate()).padStart(2, '0');
  const month = String(d.getMonth() + 1).padStart(2, '0');
  const year = d.getFullYear();
  return `${day}/${month}/${year}`;
}
---
<Layout title="Fixtures & Results" description="Upcoming fixtures and recent results for Rotherfield FC.">
  <div class="page-hero">
    <div class="container">
      <h1>Fixtures &amp; Results</h1>
      <p>Upcoming fixtures and recent results for all RFC teams.</p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <!-- Tab UI (JS progressively enhances) -->
      <div class="tab-bar" role="tablist">
        <button class="tab-btn active" role="tab" aria-selected="true" data-tab="fixtures">Upcoming Fixtures</button>
        <button class="tab-btn" role="tab" aria-selected="false" data-tab="results">Recent Results</button>
      </div>

      <div id="tab-fixtures" class="tab-panel active">
        <div class="fixtures-table-wrap">
          <table class="fixtures-table">
            <thead>
              <tr>
                <th>Team</th>
                <th>Date</th>
                <th>Time</th>
                <th>Home</th>
                <th>Away</th>
                <th>Competition</th>
                <th>Venue</th>
              </tr>
            </thead>
            <tbody>
              {fixtures.map(f => (
                <tr>
                  <td data-label="Team"><span class={`badge ${fixtureTeamMetaByKey[f.data.team].badgeClass}`}>{fixtureTeamMetaByKey[f.data.team].label}</span></td>
                  <td data-label="Date">{formatDate(f.data.date)}</td>
                  <td data-label="Time">{f.data.time}</td>
                  <td data-label="Home">
                    {f.data.isHome ? <span class="rfc-team">{fixtureTeamMetaByKey[f.data.team].rfcDisplayName}</span> : f.data.homeTeam}
                  </td>
                  <td data-label="Away">
                    {!f.data.isHome ? <span class="rfc-team">{fixtureTeamMetaByKey[f.data.team].rfcDisplayName}</span> : f.data.awayTeam}
                  </td>
                  <td data-label="Competition">{f.data.competition}</td>
                  <td data-label="Venue">{f.data.venue}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div id="tab-results" class="tab-panel">
        <div class="fixtures-table-wrap">
          <table class="fixtures-table">
            <thead>
              <tr>
                <th>Team</th>
                <th>Date</th>
                <th>Home</th>
                <th>Score</th>
                <th>Away</th>
                <th>Report</th>
                <th>Competition</th>
              </tr>
            </thead>
            <tbody>
              {results.map(r => (
                <tr>
                  <td data-label="Team"><span class={`badge ${fixtureTeamMetaByKey[r.data.team].badgeClass}`}>{fixtureTeamMetaByKey[r.data.team].label}</span></td>
                  <td data-label="Date">{formatDate(r.data.date)}</td>
                  <td data-label="Home">{r.data.isHome ? <span class="rfc-team">{fixtureTeamMetaByKey[r.data.team].rfcDisplayName}</span> : r.data.homeTeam}</td>
                  <td data-label="Score" style="font-weight:700; text-align:center;">{r.data.result}</td>
                  <td data-label="Away">{!r.data.isHome ? <span class="rfc-team">{fixtureTeamMetaByKey[r.data.team].rfcDisplayName}</span> : r.data.awayTeam}</td>
                  <td data-label="Report" class="report-cell">
                    {r.data.reportSlug ? (
                      <a
                        class="report-link"
                        href={`${import.meta.env.BASE_URL}/news/${r.data.reportSlug}`}
                        aria-label={`Read match report: ${r.data.homeTeam} vs ${r.data.awayTeam}`}
                        title="Read match report"
                      >
                        📝
                      </a>
                    ) : (
                      <span class="report-empty" aria-hidden="true">—</span>
                    )}
                  </td>
                  <td data-label="Competition">{r.data.competition}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
  tabs.forEach(btn => {
    btn.addEventListener('click', () => {
      tabs.forEach(t => { t.classList.remove('active'); t.setAttribute('aria-selected', 'false'); });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');
      document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
      const target = document.getElementById(`tab-${btn.dataset.tab}`);
      target?.classList.add('active');
    });
  });
</script>
