---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import HomeHeroSection from '../components/HomeHeroSection.astro';
import HomeNewsSection from '../components/HomeNewsSection.astro';
import HomeSponsorsSection from '../components/HomeSponsorsSection.astro';
import { sponsors } from '../data/sponsors';
import { fixtureTeamMetaByKey } from '../data/teams';

const today = new Date();
const todayStr = today.toISOString().slice(0, 10); // "YYYY-MM-DD"

const allFixtures = await getCollection('fixtures');
allFixtures.sort((a, b) => a.data.date.localeCompare(b.data.date));

const allNews = await getCollection('news');
allNews.sort((a, b) => b.data.date.localeCompare(a.data.date));
const latestNews = allNews.slice(0, 3);

const nextFixture = allFixtures.find(f => !f.data.result && f.data.date >= todayStr)?.data;
const lastResult = allFixtures
  .filter(f => !!f.data.result)
  .sort((a, b) => b.data.date.localeCompare(a.data.date))[0]?.data;

function formatDate(dateStr: string) {
  return new Date(dateStr).toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short' });
}

function resultClass(result: string, isHome: boolean) {
  const [h, a] = result.split('-').map(Number);
  const rfc = isHome ? h : a;
  const opp = isHome ? a : h;
  if (rfc > opp) return 'result-win';
  if (rfc === opp) return 'result-draw';
  return 'result-loss';
}

const categoryLabel: Record<string, string> = {
  'match-report': 'Match Report',
  'club-news': 'Club News',
  'juniors': 'Juniors',
};

// Place your hero image in public/images/ and set the path here.
// e.g. '/images/hero.jpg' — leave as null to use the default gradient.
const heroImage: string | null = '/rfc-astro/images/home-hero.avif';
---
<Layout title="Home">
  <HomeHeroSection
    heroImage={heroImage}
    nextFixture={nextFixture ?? null}
    fixtureTeamMetaByKey={fixtureTeamMetaByKey}
    formatDate={formatDate}
  />

  <section class="section" style="padding-bottom:0;">
    <div class="container">
      <div style="padding-left:0;">
        <h1 class="home-intro__title">Welcome to Rotherfield Football Club</h1>
        <p class="home-intro__text">
          Est. 1893 — The Greens. Based at Rotherfield Recreation Ground, North Street, TN6 3LX.
          A community club with junior groups from Reception to Year 13, adult teams competing in the
          Gray Hooper Holt Mid Sussex Football League, and a Veterans side in the Sussex Sunday League.
          Football for all, in the heart of the village.
        </p>
      </div>
    </div>
  </section>

  <HomeNewsSection
    latestNews={latestNews}
    categoryLabel={categoryLabel}
    formatDate={formatDate}
    fixtureTeamMetaByKey={fixtureTeamMetaByKey}
  />

  <section class="section section--alt">
    <div class="container">
      <div class="info-split">
        {lastResult && (
          <div class="info-card">
            <h3>Last Result</h3>
            <p class="fixture-meta">
              {formatDate(lastResult.date)} · {lastResult.competition}
            </p>
            <p class="fixture-score">
              {lastResult.homeTeam} <span class={resultClass(lastResult.result!, lastResult.isHome)}>{lastResult.result}</span> {lastResult.awayTeam}
            </p>
            <p class="fixture-venue">{lastResult.venue}</p>
            <a href={`${import.meta.env.BASE_URL}/fixtures#results`} style="display:inline-block; margin-top: 1rem;" class="btn btn--primary">All Results →</a>
          </div>
        )}
        {nextFixture && (
          <div class="info-card">
            <h3>Next Fixture</h3>
            <p class="fixture-meta">
              {formatDate(nextFixture.date)} · {nextFixture.time} · {nextFixture.competition}
            </p>
            <p class="fixture-score">
              {nextFixture.homeTeam} vs {nextFixture.awayTeam}
            </p>
            <p class="fixture-venue">{nextFixture.venue}</p>
            <a href={`${import.meta.env.BASE_URL}/fixtures`} style="display:inline-block; margin-top: 1rem;" class="btn btn--primary">All Fixtures →</a>
          </div>
        )}
      </div>
    </div>
  </section>

  <HomeSponsorsSection sponsors={sponsors} />
</Layout>
