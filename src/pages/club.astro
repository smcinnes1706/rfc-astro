---
import Layout from '../layouts/Layout.astro';
import ClubContactsSection from '../components/ClubContactsSection.astro';
import ClubHistorySection from '../components/ClubHistorySection.astro';
import { committee } from '../data/committee';
import { history } from '../data/club';
---
<Layout title="Club Information" description="The history, committee and background of Rotherfield Football Club, Est. 1893.">
  <div class="page-hero">
    <div class="container">
      <h1>Club Information</h1>
      <p>Everything about Rotherfield Football Club — our history, our people and our values.</p>
    </div>
  </div>

  <!-- Quick facts bar -->
  <div style="background:var(--green-pale); border-bottom:1px solid #b7e4c7;">
    <div class="container" style="padding-top:0.9rem; padding-bottom:0.9rem; display:flex; flex-wrap:wrap; gap:1.5rem; font-size:0.85rem; color:var(--green-dark); font-weight:500;">
      <span>📅 Founded: <strong>1893</strong></span>
      <span>🏟️ Ground: <strong>Rotherfield Recreation Ground</strong></span>
      <span>👕 Colours: <strong>Green &amp; White</strong></span>
      <span>🏆 League: <strong>Gray Hooper Holt Mid Sussex Football League</strong></span>
      <span>📍 <strong>TN6 3LX</strong></span>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="tab-bar" role="tablist">
        <button class="tab-btn active" role="tab" aria-selected="true" data-tab="history">History</button>
        <button class="tab-btn" role="tab" aria-selected="false" data-tab="contacts">Contacts</button>
      </div>

      <div id="tab-history" class="tab-panel active">
        <ClubHistorySection history={history} />
      </div>

      <div id="tab-contacts" class="tab-panel">
        <ClubContactsSection committee={committee} />
      </div>
    </div>
  </section>

  <div class="cta-bar">
    <div class="container">
      <h2>Get Involved</h2>
      <p>Interested in volunteering, joining the committee or supporting the club in other ways?</p>
      <a href="mailto:enquiriesrfc1893@gmail.com?subject=Volunteering%20Enquiry" class="btn btn--white">Get in Touch</a>
    </div>
  </div>
</Layout>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
  tabs.forEach(btn => {
    btn.addEventListener('click', () => {
      tabs.forEach(t => { t.classList.remove('active'); t.setAttribute('aria-selected', 'false'); });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');
      document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
      const target = document.getElementById(`tab-${btn.dataset.tab}`);
      target?.classList.add('active');
    });
  });
</script>
