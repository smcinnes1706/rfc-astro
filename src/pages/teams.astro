---
import Layout from '../layouts/Layout.astro';
import { teams } from '../data/teams';

const adultTeams = teams.filter(t => t.type === 'adult' || t.type === 'vets');
const juniorTeams = teams.filter(t => t.type === 'junior');

const icons: Record<string, string> = {
  'first-team': '🏆',
  'reserves': '⚽',
  'vets': '🎖️',
  'juniors-u6-u11': '⭐',
  'juniors-u12-u18': '🌟',
  'girls-wildcats': '🌸',
};
---
<Layout title="Teams" description="All teams at Rotherfield FC — adults, juniors, vets and Girls Wildcats.">
  <div class="page-hero">
    <div class="container">
      <h1>Our Teams</h1>
      <p>From school reception all the way to over-35s — there's a team for everyone at RFC.</p>
    </div>
  </div>

  <!-- Adult teams -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>Adult &amp; Veterans Teams</h2>
        <p>Competitive football in the Mid Sussex and Sussex Sunday leagues.</p>
      </div>
      <div class="teams-grid">
        {adultTeams.map(team => (
          <div class={`card team-card${team.image ? ' team-card--has-image' : ''}`} id={team.id}>
            <div class="team-card__media">
              {team.image
                ? <img src={team.image} alt={team.name} class="team-card__banner" />
                : <div class="team-card__icon">{icons[team.id] ?? '⚽'}</div>
              }
            </div>
            <div class="team-card__content">
              <h3 class="card__title">{team.name}</h3>
              <p class="team-card__league">{team.league}</p>
              {team.manager && <p style="font-size:0.8rem; color:var(--grey-mid); margin-bottom:0.4rem;">Manager: {team.manager}</p>}
              <p>{team.description}</p>
              <a href={`${team.fulltimeLink}`} class="team-card__cta" target="_blank">
                FA Fulltime Homepage 🌐
              </a>
              <a href={`mailto:${team.contactEmail}?subject=Player%20Enquiry%20-%20${encodeURIComponent(team.name)}`} class="team-card__cta">
                Enquire about joining →
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Junior teams -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-header">
        <h2>Junior Teams</h2>
        <div class="teams-story">
          <p>The current Rotherfield Junior FC was founded in 1998. Our ambition is to provide high quality football coaching for children of all ages and all abilities. We are an Accredited England Football Club, which means we follow best practice in the way we coach, develop and look after our young players.</p>
          <p>We field teams from Under 7 level upwards in the Crowborough &amp; District Football League.</p>
          <p>All age groups have coaches who have completed Introduction To Coaching Football or (Formerly named) FA Level One coaching qualifications.</p>
          <p>Younger age groups compete in 5 &amp; 7-a-side mini soccer, progressing to 9 v 9 and then 11-a-side football for older age groups. We also provide training sessions for Reception, Year 1 and Year 2 children, to help them learn the game and have fun.</p>
          <p>On Friday evenings we hold an all girls Wildcats session for ages 4-11.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Join CTA -->
  <div id="join" class="cta-bar">
    <div class="container">
      <h2>Interested in Joining?</h2>
      <p>Get in touch and we'll point you in the right direction for your age group and ability.</p>
      <a href="mailto:enquiriesrfc1893@gmail.com?subject=Player%20Enquiry" class="btn btn--white">
        Email enquiriesrfc1893@gmail.com
      </a>
    </div>
  </div>
</Layout>
