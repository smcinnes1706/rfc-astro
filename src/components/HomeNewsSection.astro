---
interface Props {
  latestNews: any[];
  categoryLabel: Record<string, string>;
  formatDate: (dateStr: string) => string;
  fixtureTeamMetaByKey: Record<string, any>;
}

const { latestNews, categoryLabel, formatDate, fixtureTeamMetaByKey } = Astro.props as Props;
---

<section class="section">
  <div class="container">
    <div class="section-header section-header--flex">
      <div>
        <h2>Latest News</h2>
        <p>Match reports, club updates and more</p>
      </div>
      <a href={`${import.meta.env.BASE_URL}/news`} class="btn btn--outline">All News →</a>
    </div>
    <div class="news-grid">
      {latestNews.map(entry => (
        <article class={`card news-card${entry.data.image ? ' news-card--has-image' : ''}`}>
          <a href={`${import.meta.env.BASE_URL}/news/${entry.id}`} aria-label={`Read article: ${entry.data.title}`}>
            {entry.data.image
              ? <img src={entry.data.image} alt={entry.data.title} class="news-card__img news-card__img--photo" />
              : <div class="news-card__img">⚽</div>
            }
          </a>
          <div class="card__body news-card__body">
            <div class="news-card__meta">
              <span class={`badge ${entry.data.category === 'match-report' ? 'badge--green' : entry.data.category === 'juniors' ? 'badge--gold' : 'badge--grey'}`}>
                {categoryLabel[entry.data.category]}
              </span>
              {entry.data.team && (
                <span class={`badge ${fixtureTeamMetaByKey[entry.data.team].badgeClass}`}>{fixtureTeamMetaByKey[entry.data.team].label}</span>
              )}
              <span class="news-card__date">{formatDate(entry.data.date)}</span>
            </div>
            <h3 class="card__title news-card__title"><a href={`${import.meta.env.BASE_URL}/news/${entry.id}`}>{entry.data.title}</a></h3>
            <p class="news-card__excerpt">{entry.data.excerpt}</p>
            <a class="news-card__link" href={`${import.meta.env.BASE_URL}/news/${entry.id}`}>Read more →</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
