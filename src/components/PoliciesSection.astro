---
import type { PolicyDocument } from '../data/policies';

interface Policy {
  id: string;
  title: string;
  icon: string;
  body: string[];
}

interface ExternalResource {
  label: string;
  url: string;
}

interface Props {
  policies: Policy[];
  policydocs: PolicyDocument[];
  resources?: ExternalResource[];
}

const { policies, policydocs,  resources = [] } = Astro.props as Props;
---



<section class="section section--alt" style="padding-top:2rem; padding-bottom:0; margin-top:2rem;">
  <div class="container" style="padding-left:0; padding-right:0;">
    <div class="section-header">
      <h2>Policy Documents</h2>
      <p>Useful links for safeguarding, welfare and FA policies.</p>
    </div>
    <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(240px, 1fr)); gap:1rem; max-width:800px;">
      {policydocs.map(doc => (
        <a
          href={doc.filename}
          target="_blank"
          rel="noopener noreferrer"
          class="sponsor-card"
          style="display:block; text-align:left; padding:1rem 1.1rem;"
        >
          <p style="font-size:0.875rem; font-weight:600; color:var(--green-dark); margin-bottom:0.2rem;">{doc.title}</p>
          <p style="font-size:0.75rem; color:var(--green-mid);">Visit document →</p>
        </a>
      ))}
    </div>
  </div>
</section>
